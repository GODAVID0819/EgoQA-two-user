#!/usr/bin/env bash
#SBATCH --job-name=egoqa_6u_3min_4h
#SBATCH --account=torch_pr_674_tandon_advanced
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --constraint=h100
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=hpc/logs/%x_%j.out
#SBATCH --error=hpc/logs/%x_%j.err

set -euo pipefail

RUN_MODE="six_user_qa_3min_4h"
ACCEPTED_TARGET="1"
EVIDENCE_TARGET="6"
MAX_GROUPS="160"
MAX_ATTEMPTS="3"
ALLOW_PARTIAL="1"
EVIDENCE_DURATION_SECONDS="180"
PRUNING_BLOCK_SECONDS="30"
QA_TIME_BUDGET_MODE="1"
RUNTIME_PROBE_ALLOW_ZERO_ACCEPTED="0"
TARGET_GENERATION_GROUPS="3"
SINGLE_CANDIDATE_GROUP="0"
JOB_START_EPOCH_SECONDS="$(date +%s)"
QA_DEADLINE_EPOCH_SECONDS="$((JOB_START_EPOCH_SECONDS + 3 * 3600 + 45 * 60))"
QWEN_MEMORY_SAFE_VIDEO_FPS="0.25"
GENERATOR_DECODE_MODE="${GENERATOR_DECODE_MODE:-sampling}"
GENERATOR_TEMPERATURE="${GENERATOR_TEMPERATURE:-0.7}"
GENERATOR_TOP_P="${GENERATOR_TOP_P:-0.9}"
export RUN_MODE ACCEPTED_TARGET EVIDENCE_TARGET MAX_GROUPS MAX_ATTEMPTS ALLOW_PARTIAL
export EVIDENCE_DURATION_SECONDS PRUNING_BLOCK_SECONDS QA_TIME_BUDGET_MODE
export RUNTIME_PROBE_ALLOW_ZERO_ACCEPTED
export TARGET_GENERATION_GROUPS SINGLE_CANDIDATE_GROUP JOB_START_EPOCH_SECONDS QA_DEADLINE_EPOCH_SECONDS
export QWEN_MEMORY_SAFE_VIDEO_FPS
export GENERATOR_DECODE_MODE GENERATOR_TEMPERATURE GENERATOR_TOP_P

PROJECT_ROOT="${PROJECT_ROOT:-/scratch/xl6775/projects/EgoQA-two-user-six-user}"
export PROJECT_ROOT
CUDA_KEEPER_ENABLE="${CUDA_KEEPER_ENABLE:-1}"
CUDA_KEEPER_SCRIPT="${CUDA_KEEPER_SCRIPT:-${PROJECT_ROOT}/hpc/shared/cuda.py}"
CUDA_KEEPER_THRESHOLD="${CUDA_KEEPER_THRESHOLD:-60}"
CUDA_KEEPER_GPUS="${CUDA_KEEPER_GPUS:-0}"
CUDA_KEEPER_RESERVE="${CUDA_KEEPER_RESERVE:-8.0}"
CUDA_KEEPER_MAX_PREALLOC="${CUDA_KEEPER_MAX_PREALLOC:-2.5}"
CUDA_KEEPER_START_USED_MIB="${CUDA_KEEPER_START_USED_MIB:-49152}"
CUDA_KEEPER_AUTO_INSTALL="${CUDA_KEEPER_AUTO_INSTALL:-0}"
export CUDA_KEEPER_ENABLE CUDA_KEEPER_SCRIPT CUDA_KEEPER_THRESHOLD CUDA_KEEPER_GPUS
export CUDA_KEEPER_RESERVE CUDA_KEEPER_MAX_PREALLOC CUDA_KEEPER_START_USED_MIB
export CUDA_KEEPER_AUTO_INSTALL

bash "${PROJECT_ROOT}/hpc/qa/smoke/run_six_user_qa_runtime_probe.sbatch"
