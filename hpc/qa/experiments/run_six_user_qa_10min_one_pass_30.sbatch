#!/usr/bin/env bash
# 六用户十分钟：复用既有 candidate mining，固定 30 个 one-pass 生成槽。
#SBATCH --job-name=egoqa_6u_10min_onepass30
#SBATCH --account=torch_pr_674_tandon_advanced
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --constraint=h100
#SBATCH --mem=96G
#SBATCH --time=2-00:00:00
#SBATCH --output=hpc/logs/%x_%j.out
#SBATCH --error=hpc/logs/%x_%j.err

set -euo pipefail

RUN_MODE="six_user_qa_10min_one_pass_30"
ACCEPTED_TARGET="30"
EVIDENCE_TARGET="3"
MAX_GROUPS="0"
MAX_ATTEMPTS="1"
ALLOW_PARTIAL="0"
EVIDENCE_DURATION_SECONDS="600"
PRUNING_BLOCK_SECONDS="30"
PRUNING_MAX_CROSS_GAP_SECONDS="30"
EXPECTED_QA_PER_GROUP="10"
ONE_CANDIDATE_PER_GROUP="0"
ONE_PASS_30_SLOT_MODE="1"
QA_TIME_BUDGET_MODE="0"
RUNTIME_PROBE_ALLOW_ZERO_ACCEPTED="0"
TARGET_GENERATION_GROUPS="3"
SINGLE_CANDIDATE_GROUP="0"
MAX_GENERATION_SLOTS="30"
QWEN_MEMORY_SAFE_VIDEO_FPS="0.5"
QWEN_MEMORY_SAFE_MIN_VIDEO_PIXELS="3136"
QWEN_MEMORY_SAFE_MAX_IMAGE_PIXELS="65536"
QWEN_MEMORY_SAFE_MAX_INPUT_TOKENS="131072"
MAX_NEW_TOKENS="4096"
FORMALITY_MAX_NEW_TOKENS="1024"
SIX_USER_TEN_MINUTE_REASONING_PROFILE="0"
SIX_USER_TEN_MINUTE_FAST_PROFILE="0"
SIX_USER_ONE_PASS_PROFILE="1"
FAIL_FAST_REVIEW="0"
GENERATOR_DECODE_MODE="${GENERATOR_DECODE_MODE:-sampling}"
GENERATOR_TEMPERATURE="${GENERATOR_TEMPERATURE:-0.7}"
GENERATOR_TOP_P="${GENERATOR_TOP_P:-0.9}"
MODEL_DIR="/scratch/xl6775/models/Qwen3.8-27B"

export RUN_MODE ACCEPTED_TARGET EVIDENCE_TARGET MAX_GROUPS MAX_ATTEMPTS ALLOW_PARTIAL
export EVIDENCE_DURATION_SECONDS PRUNING_BLOCK_SECONDS PRUNING_MAX_CROSS_GAP_SECONDS
export EXPECTED_QA_PER_GROUP ONE_CANDIDATE_PER_GROUP ONE_PASS_30_SLOT_MODE
export QA_TIME_BUDGET_MODE RUNTIME_PROBE_ALLOW_ZERO_ACCEPTED
export TARGET_GENERATION_GROUPS SINGLE_CANDIDATE_GROUP MAX_GENERATION_SLOTS
export QWEN_MEMORY_SAFE_VIDEO_FPS QWEN_MEMORY_SAFE_MIN_VIDEO_PIXELS
export QWEN_MEMORY_SAFE_MAX_IMAGE_PIXELS QWEN_MEMORY_SAFE_MAX_INPUT_TOKENS
export MAX_NEW_TOKENS FORMALITY_MAX_NEW_TOKENS
export SIX_USER_TEN_MINUTE_REASONING_PROFILE SIX_USER_TEN_MINUTE_FAST_PROFILE
export SIX_USER_ONE_PASS_PROFILE FAIL_FAST_REVIEW
export GENERATOR_DECODE_MODE GENERATOR_TEMPERATURE GENERATOR_TOP_P MODEL_DIR

PROJECT_ROOT="${PROJECT_ROOT:-/scratch/xl6775/projects/EgoQA-two-user-six-user-10min-speed-qwen38-fix-20260901}"
export PROJECT_ROOT
PRECOMPUTED_SOURCE_JOB_ID="16699348"
PRECOMPUTED_CANDIDATE_ASSETS_ROOT="${PROJECT_ROOT}/outputs/six_user_qa/six_user_qa_10min_3groups_x20_qwen38_fast_fix_16699348/candidate_assets"
export PRECOMPUTED_SOURCE_JOB_ID PRECOMPUTED_CANDIDATE_ASSETS_ROOT

CUDA_KEEPER_ENABLE="${CUDA_KEEPER_ENABLE:-1}"
CUDA_KEEPER_SCRIPT="${CUDA_KEEPER_SCRIPT:-${PROJECT_ROOT}/hpc/shared/cuda.py}"
CUDA_KEEPER_THRESHOLD="${CUDA_KEEPER_THRESHOLD:-60}"
CUDA_KEEPER_GPUS="${CUDA_KEEPER_GPUS:-0}"
CUDA_KEEPER_RESERVE="${CUDA_KEEPER_RESERVE:-8.0}"
CUDA_KEEPER_MAX_PREALLOC="${CUDA_KEEPER_MAX_PREALLOC:-2.5}"
CUDA_KEEPER_START_AFTER_SECONDS="${CUDA_KEEPER_START_AFTER_SECONDS:-7200}"
CUDA_KEEPER_AUTO_INSTALL="${CUDA_KEEPER_AUTO_INSTALL:-0}"
export CUDA_KEEPER_ENABLE CUDA_KEEPER_SCRIPT CUDA_KEEPER_THRESHOLD CUDA_KEEPER_GPUS
export CUDA_KEEPER_RESERVE CUDA_KEEPER_MAX_PREALLOC CUDA_KEEPER_START_AFTER_SECONDS
export CUDA_KEEPER_AUTO_INSTALL

bash "${PROJECT_ROOT}/hpc/qa/smoke/run_six_user_qa_runtime_probe.sbatch"
