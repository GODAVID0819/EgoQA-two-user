#!/bin/bash
#SBATCH --job-name=aria12-prepare
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=00:30:00
set -euo pipefail
cd "$ARIA_ROOT"
export CUDA_VISIBLE_DEVICES="" PYTHONDONTWRITEBYTECODE=1 VLLM_NO_USAGE_STATS=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
for k in HOME XDG_CACHE_HOME HF_HOME HF_DATASETS_CACHE MODELSCOPE_CACHE TORCH_HOME TRITON_CACHE_DIR TORCHINDUCTOR_CACHE_DIR VLLM_CACHE_ROOT FLASHINFER_WORKSPACE_BASE TMPDIR TMP TEMP CUDA_CACHE_PATH; do
 v="/scratch/xl6775/ag12/$SLURM_JOB_ID/${k,,}"; mkdir -p "$v"; export "$k=$v"
done
export PYTHONPATH="$ARIA_ROOT/runtime_deps_train:$ARIA_ROOT/multi-user:$ARIA_ROOT"
exec "$ARIA_PYTHON" -u cpu_aria12.py
